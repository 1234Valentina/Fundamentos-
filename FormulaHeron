#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float a, b, c, s, area;
    cout<<"Escribir lado a: ";
    cin>>a;
    cout<<"Escibir lado b: ";
    cin>>b;
    cout<<"lado c: " ;
    cin>>c;
    s=(a+b+c)/2.0;
    area=sqrt(s*(s-a)*(s-b)*(s-c));
    cout<<"El area es: "<<area;
   
    return 0;
}
